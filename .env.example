# UniFi Site Manager API key (create at unifi.ui.com — treat as a secret)
UNIFI_API_KEY=
# Express 7 console id (see ../memory.md)
UNIFI_CONSOLE_ID=
# NVR console id — optional, enables Protect health monitoring (see ../memory.md)
UNIFI_NVR_CONSOLE_ID=
# Optional push notifications: an ntfy topic URL, e.g. https://ntfy.sh/<your-secret-topic>
NTFY_URL=
